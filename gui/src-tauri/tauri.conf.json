{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comma Sync",
  "version": "1.0.4",
  "identifier": "ai.comma.sync.gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Comma Sync",
        "width": 640,
        "height": 760,
        "minWidth": 560,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/comma-sync"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
